<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} · Secure Login</title>
    <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
<main class="card">
    <header class="brand">
        <span class="brand-mark" aria-hidden="true">✦</span>
        <span>Secure Login</span>
    </header>

    <h1>{{ title }}</h1>

    {% if flash.success %}
        <p class="notice success" role="status">{{ flash.success }}</p>
    {% endif %}
    {% if flash.error %}
        <p class="notice error" role="status">{{ flash.error }}</p>
    {% endif %}
    {% if error is defined and error %}
        <p class="notice error" role="status">{{ error }}</p>
    {% endif %}
    {% if success is defined and success %}
        <p class="notice success" role="status">{{ success }}</p>
    {% endif %}

    {% block content %}{% endblock %}
</main>
</body>
</html>
