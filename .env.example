# Copy to .env. Never commit .env.
DB_HOST=127.0.0.1
DB_NAME=auth_system
DB_USER=root
DB_PASSWORD=
APP_URL=http://localhost:8000
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=Login Demo <login@your-verified-domain.example>
# Generate with: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
APP_KEY=replace_with_base64_encoded_32_random_bytes
