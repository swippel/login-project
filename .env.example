# =====================================================================
# Secure Login — Konfiguration
#
# Diese Datei ist die Vorlage. Kopiere sie nach .env und trage die Werte ein:
#     cp .env.example .env
#
# .env gehoert nicht in die Versionsverwaltung (siehe .gitignore).
# =====================================================================

# --- Datenbank -------------------------------------------------------
DB_HOST=127.0.0.1
DB_NAME=auth_system
DB_USER=root
DB_PASSWORD=

# --- Anwendung --------------------------------------------------------
# Adresse, unter der das Projekt erreichbar ist. Wird fuer die Reset-Links
# und die Bestaetigungscodes verwendet.
APP_URL=http://127.0.0.1:8081


# --- E-Mail-Versand (Resend) -----------------------------------------
# Ohne diese Werte laeuft die Anwendung, aber es wird keine Mail verschickt.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=Secure Login <login@your-verified-domain.example>

# --- Verschluesselungsschluessel --------------------------------------
# Erzeugen mit:
#     php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
#
# WICHTIG: Der Wert darf nach dem ersten Start nicht mehr geaendert werden.
# Sonst lassen sich die gespeicherten 2FA-Geheimnisse nicht mehr entschluesseln.
APP_KEY=replace_with_base64_encoded_32_random_bytes

# --- Docker Compose --------------------------------------------------
# Port, an dem der Webserver lauscht.
WEB_PORT=8081

# Passwort des MariaDB-Root-Kontos im Container.
DB_ROOT_PASSWORD=root
