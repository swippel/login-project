# =====================================================================
# Secure Login — Konfiguration
#
# Diese Datei ist die Vorlage. Kopiere sie nach .env und trage die Werte ein:
#     cp .env.example .env
#
# .env gehoert nicht in die Versionsverwaltung (siehe .gitignore).
# =====================================================================

# --- Datenbank -------------------------------------------------------
DB_HOST=127.0.0.1
DB_NAME=auth_system
DB_USER=root
DB_PASSWORD=

# --- Anwendung --------------------------------------------------------
# Adresse, unter der das Projekt erreichbar ist. Wird fuer die Reset-Links
# und die Bestaetigungscodes verwendet.
APP_URL=http://127.0.0.1:8081


# --- E-Mail-Versand (SMTP ueber Resend) -------------------------------
# API-Key: resend.com -> API Keys -> Create API Key (beginnt mit "re_").
# Die Absender-Domain muss in Resend verifiziert sein (resend.com -> Domains).
# Der API-Key ist das SMTP-Passwort, SMTP_USER ist immer "resend".
#
# SMTP_PASSWORD leer = Entwicklungsmodus: Es wird keine Mail verschickt, Codes und
# Links erscheinen im Browser und im Log (docker compose logs -f app).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
# Verschluesselung: starttls (Port 587), ssl (Port 465) oder none (nur lokal)
SMTP_SECURE=starttls
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=noreply@smoothingo.com

# --- Verschluesselungsschluessel --------------------------------------
# Erzeugen mit:
#     php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
#
# WICHTIG: Der Wert darf nach dem ersten Start nicht mehr geaendert werden.
# Sonst lassen sich die gespeicherten 2FA-Geheimnisse nicht mehr entschluesseln.
APP_KEY=replace_with_base64_encoded_32_random_bytes

# --- Docker Compose --------------------------------------------------
# Port, an dem der Webserver lauscht.
WEB_PORT=8081

# Passwort des MariaDB-Root-Kontos im Container.
DB_ROOT_PASSWORD=root
