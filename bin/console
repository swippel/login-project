#!/usr/bin/env php
<?php

declare(strict_types=1);

use SecureLogin\Application;
use SecureLogin\EmailCodes;
use SecureLogin\Totp;

require_once dirname(__DIR__) . '/vendor/autoload.php';

/**
 * Verwaltung auf der Kommandozeile:  php bin/console <befehl> [argumente]
 */
$commands = [
    'user:list' => 'Konten auflisten',
    'user:create <email> [passwort]' => 'Konto anlegen (ohne Passwort wird eines erzeugt)',
    'user:email-code <email> <on|off>' => 'E-Mail-Bestaetigung umschalten',
    'user:totp-off <email>' => '2FA eines Kontos entfernen',
    'dev:totp-code <email>' => 'Aktuellen 2FA-Code berechnen (zum Testen)',
    'dev:email-code <email> [code]' => 'E-Mail-Code fuer die Anmeldung hinterlegen, Standard 123456 (zum Testen)',
];

[, $command, $email, $extra] = $argv + [null, 'help', null, null];

if (!in_array($command, array_map(fn ($c) => explode(' ', $c)[0], array_keys($commands)), true)) {
    echo "Befehle:\n";
    foreach ($commands as $usage => $description) {
        printf("  %-34s %s\n", $usage, $description);
    }
    exit($command === 'help' ? 0 : 1);
}

$app = new Application(dirname(__DIR__));

if ($command === 'user:list') {
    foreach ($app->users->all() as $user) {
        printf(
            "%-4d %-32s mailcode:%-4s 2fa:%-4s %s\n",
            $user['id'],
            $user['email'],
            $user['email_code_login'] ? 'ja' : 'nein',
            $app->twoFactor->isEnabled((int) $user['id']) ? 'ja' : 'nein',
            $user['last_login'] ?? '-',
        );
    }
    exit(0);
}

$cleanEmail = $app->security->cleanEmail((string) $email);

if ($cleanEmail === null) {
    fwrite(STDERR, "Bitte eine gueltige E-Mail-Adresse angeben.\n");
    exit(1);
}

$user = $app->users->findByEmail($cleanEmail);

if ($command === 'user:create') {
    $password = $extra ?? bin2hex(random_bytes(12));

    if ($user !== null || ($error = $app->security->passwordError($password, $password)) !== null) {
        fwrite(STDERR, ($user !== null ? 'Diese E-Mail-Adresse ist bereits registriert.' : $error) . "\n");
        exit(1);
    }

    $id = $app->users->create($cleanEmail, $app->security->hashPassword($password));
    echo "Konto angelegt: $cleanEmail (ID $id)", $extra === null ? ", Passwort: $password" : '', "\n";
    exit(0);
}

if ($user === null) {
    fwrite(STDERR, "Konto nicht gefunden.\n");
    exit(1);
}

$userId = (int) $user['id'];

switch ($command) {
    case 'user:email-code':
        if (!in_array($extra, ['on', 'off'], true)) {
            fwrite(STDERR, "Zweiter Wert muss 'on' oder 'off' sein.\n");
            exit(1);
        }
        $app->users->setEmailCode($userId, $extra === 'on');
        echo "E-Mail-Bestaetigung fuer $cleanEmail: ", $extra === 'on' ? 'an' : 'aus', "\n";
        break;

    case 'user:totp-off':
        $app->database->execute('DELETE FROM user_totp WHERE user_id = ?', [$userId]);
        echo "2FA fuer $cleanEmail entfernt.\n";
        break;

    case 'dev:totp-code':
        $row = $app->database->one('SELECT secret_nonce, secret_ciphertext FROM user_totp WHERE user_id = ?', [$userId]);
        if ($row === null) {
            fwrite(STDERR, "Fuer dieses Konto ist keine 2FA eingerichtet.\n");
            exit(1);
        }
        $secret = $app->security->decrypt($row['secret_nonce'], $row['secret_ciphertext']);
        echo Totp::code($secret, intdiv(time(), 30)), "\n";
        break;

    case 'dev:email-code':
        $code = $extra ?? '123456';
        $app->emailCodes->clear($userId, EmailCodes::LOGIN);
        $app->database->execute(
            'INSERT INTO email_verifications (user_id, code_hash, purpose, expires_at)
             VALUES (?, ?, ?, DATE_ADD(UTC_TIMESTAMP(), INTERVAL 10 MINUTE))',
            [$userId, $app->security->hashCode($code), EmailCodes::LOGIN],
        );
        echo "Code $code fuer $cleanEmail hinterlegt.\n";
        break;
}
